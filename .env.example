# ── Fill these in ────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# ── Working defaults — change only if you need to ────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
COMMAND_PREFIX=!

DATABASE_URL=postgres://bot:bot@127.0.0.1:55432/bot
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=2000
DATABASE_RETRY_DEADLINE_MS=2000

DISCORD_READY_TIMEOUT_MS=60000

REDIS_URL=
OPS_PORT=3000
OPS_METRICS_TOKEN=
SHUTDOWN_TIMEOUT_MS=10000

# ── Notes ────────────────────────────────────────────────────────────────────
#
# DISCORD_TOKEN            Bot → Reset Token
# DISCORD_CLIENT_ID        General Information → Application ID
# DISCORD_DEV_GUILD_ID     Your test server, right-click → Copy Server ID.
#                          Optional; with it, commands appear instantly.
# DISCORD_READY_TIMEOUT_MS Abandon the boot if the gateway never goes ready.
#
# COMMAND_PREFIX           Runs "!ping" as well as "/ping" — same command, same
#                          code. Needs the Message Content intent enabled for
#                          your app (Bot → Privileged Gateway Intents); without
#                          it Discord refuses the login and says exactly that.
#                          Blank or absent turns message commands off and drops
#                          the intent, so a deploy that omits this is safe.
#
# DATABASE_URL             Works with `pnpm db:start` and Docker alike.
# DATABASE_POOL_MIN/MAX    Connections held open, and the ceiling.
# DATABASE_*_TIMEOUT/RETRY Both below Discord's 3s reply window, so neither can
#                          lose an interaction. Retry 0 disables retries.
#
# REDIS_URL                Only needed to run more than one instance. Blank
#                          means caches and job locks are per-process.
# OPS_PORT                 Serves /healthz, /readyz and /metrics.
# OPS_METRICS_TOKEN        Any long random string, to enable /metrics. Blank
#                          means open in development, off in production.
#
# Read once, in src/platform/config/, which explains anything missing at start.
