{
  "compilerOptions": {
    // ── Output target ────────────────────────────────────────────────────────
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Resolves the "#platform/*" style subpath imports declared in package.json
    // to ./src at compile time. At runtime the "development" condition is set by
    // tsx (dev) and absent under plain node (prod), which resolves to ./dist.
    "customConditions": ["development"],

    // ── Strictness ───────────────────────────────────────────────────────────
    // Every one of these is load-bearing, not decoration. See docs/architecture.md.
    "strict": true,
    // Discord payloads are full of optional fields; without this, arr[0] lies
    // about being defined and the lie surfaces in production.
    "noUncheckedIndexedAccess": true,
    // Distinguishes "absent" from "present and undefined" — matters for partial
    // update objects hitting the database.
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // ── Module semantics ─────────────────────────────────────────────────────
    // Forces `import type` for type-only imports, so erased imports never carry
    // a runtime side effect by accident.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // ── Emit ─────────────────────────────────────────────────────────────────
    "noEmit": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
